---
import MainLayout from "../layouts/MainLayout.astro";
import BookCard from "../components/BookCard.astro";

const query = Astro.url.searchParams.get("q") || "popular books";
// يعني:
// إذا المستخدم كتب شي بالبحث → خديه
// إذا ما كتب شي → استخدمي popular books
const encodedQuery = encodeURIComponent(query);

const response = await fetch(
    `https://openlibrary.org/search.json?q=${encodedQuery}`,
);
const data = await response.json();
const books = data.docs.slice(0, 12);
---

<MainLayout title="Search books">
    <section class="search-page">
        <h1>Search books</h1>

        <form class="search-form" action="/books" method="GET">
            <!-- يعني:

لما المستخدم يضغط Search
الصفحة تروح إلى /books?q=... -->
            <label for="q">Search for a book</label>
            <input
                id="q"
                name="q"
                type="search"
                value={query}
                placeholder="Try: fantasy, romance, history..."
            />
            <button type="submit">Search</button>
        </form>

        <p class="results-text">
            Results for: <strong>{query}</strong>
        </p>

        {
            books.length > 0 ? (
                <section class="books-grid">
                    {books.map((book: any) => (
                        <BookCard book={book} />
                    ))}
                </section>
            ) : (
                <p>No books found.</p>
            )
        }
    </section>
</MainLayout>

<style>
    .search-page {
        display: grid;
        gap: 1.5rem;
    }

    .search-form {
        display: grid;
        gap: 0.75rem;
        max-width: 32rem;
    }

    .search-form label {
        font-weight: 600;
    }

    .search-form input {
        padding: 0.85rem 1rem;
        border: 1px solid #d8d2c8;
        border-radius: 0.75rem;
        font: inherit;
    }

    .search-form button {
        width: fit-content;
        padding: 0.85rem 1.2rem;
        border: none;
        border-radius: 0.75rem;
        background: #222;
        color: white;
        font: inherit;
        cursor: pointer;
    }

    .results-text {
        margin: 0;
        color: #555;
    }
</style>
