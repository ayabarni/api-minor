---
import MainLayout from "../../layouts/MainLayout.astro";

const { id } = Astro.params;
const url = `https://openlibrary.org/${id}.json`;
const transitionName = `book-${String(id).replaceAll("/", "-")}`;

let book: any = {
    title: "Book not found",
    description: "No description available",
};

try {
    const response = await fetch(url);
    book = await response.json();
} catch (error) {
    console.error("Problem fetching book:", error);
}
// const firstPublishDate = book.first_publish_date || "";
const publishDate = book.created?.value?.slice(0, 10) || "";

const subjects = book.subjects?.slice(0, 4) || [];
const pages = book.number_of_page || "";
const mainSubject = subjects[0] || "";
const coverId = book.covers?.[0];
const authorKey = book.authors?.[0]?.author?.key;

const allSubjects = book.subjects?.join(" ").toLowerCase() || "";
const genreClass =
    allSubjects.includes("romance") || allSubjects.includes("love")
        ? "genre-romance"
        : allSubjects.includes("horror") || allSubjects.includes("ghost")
          ? "genre-horror"
          : allSubjects.includes("action") || allSubjects.includes("adventure")
            ? "genre-action"
            : allSubjects.includes("fantasy") || allSubjects.includes("magic")
              ? "genre-fantasy"
              : allSubjects.includes("science fiction") ||
                  allSubjects.includes("sci-fi")
                ? "genre-scifi"
                : "genre-default";

let author = "Unknown author";

if (authorKey) {
    try {
        const authorResponse = await fetch(
            `https://openlibrary.org${authorKey}.json`,
        );
        const authorData = await authorResponse.json();
        author = authorData.name || "Unknown author";
    } catch (error) {
        console.error("Problem fetching author:", error);
    }
}

const description =
    typeof book.description === "object"
        ? book.description?.value
        : book.description || "No description available";
let relatedBooks: any[] = [];

if (mainSubject) {
    try {
        const relatedResponse = await fetch(
            `https://openlibrary.org/search.json?subject=${encodeURIComponent(mainSubject)}`,
        );
        const relatedData = await relatedResponse.json();
        relatedBooks = relatedData.docs
            .filter((relatedBook: any) => relatedBook.key !== `/${id}`)
            .slice(0, 6);
    } catch (error) {
        console.error("Problem fetching related books:", error);
    }
}
---

<MainLayout title={book.title}>
    <!-- <a class="back-link" href="/search"></a> -->
    <button class="terug-link" type="button" id="terugButton"
        >← Back to search</button
    >

    <article class="book-detail">
        <div class={`book-cover ${genreClass}`}>
            {
                coverId ? (
                    <div class="book-3d">
                        <div class="particles">
                            <>
                                <span />
                                <span />
                            </>
                            <>
                                <span />
                                <span />
                            </>
                            <span />
                        </div>
                        <img
                            src={`https://covers.openlibrary.org/b/id/${coverId}-M.jpg`}
                            alt={`Cover of ${book.title}`}
                            loading="eager"
                            decoding="sync"
                            fetchpriority="high"
                            style={`view-transition-name: ${transitionName};`}
                        />
                    </div>
                ) : (
                    <div class="cover-placeholder">No cover available</div>
                )
            }
        </div>
        <div class="book-info">
            <p class="author">{author}</p>
            <h1>{book.title}</h1>
            <div class="book-meta">
                {publishDate && <span> Published: {publishDate}</span>}
                {pages && <span>{pages} pages</span>}
                {subjects.map((subject: string) => <span>{subject}</span>)}
            </div>

            <div class="actions">
                <select
                    class="shelf-select"
                    data-key={`/${id}`}
                    data-title={book.title}
                    data-cover={coverId || ""}
                    data-author={author}
                >
                    <option value="">Add to shelf</option>
                    <option value="want-to-read">Want to read</option>
                    <option value="currently-reading">Currently reading</option>
                    <option value="read">Read</option>
                    <option value="remove">Remove</option>
                </select>

                <button class="share-button" type="button">↗ Share</button>
            </div>

            <section class="description">
                <h2>Description</h2>
                <p>{description}</p>
            </section>

            <!--  -->
        </div>
    </article>
    {
        relatedBooks.length > 0 && (
            <section class="related-books">
                <h2>Related books</h2>
                <div class="related-grid">
                    {relatedBooks.map((relatedBook: any) => (
                        <a
                            href={`/book${relatedBook.key}`}
                            class="related-card"
                        >
                            {relatedBook.cover_i ? (
                                <img
                                    src={`https://covers.openlibrary.org/b/id/${relatedBook.cover_i}-M.jpg`}
                                    alt={`Cover of ${relatedBook.title}`}
                                />
                            ) : (
                                <div class="related-placeholder">No cover</div>
                            )}

                            <h3>{relatedBook.title}</h3>
                        </a>
                    ))}
                </div>
            </section>
        )
    }
</MainLayout>

<script>
    type ShelfBook = {
        key: string;
        title: string;
        cover_i?: number;
        author_name?: string[];
        shelf: string;
        lastUpdated?: number;
    };

    const terugButton = document.querySelector("#terugButton");
    terugButton?.addEventListener("click", () => {
        history.back();
    });

    const select = document.querySelector(
        ".shelf-select",
    ) as HTMLSelectElement | null;

    if (select) {
        const key = select.dataset.key || "";
        const saved: ShelfBook[] = JSON.parse(
            localStorage.getItem("shelfBooks") || "[]",
        );

        const existing = saved.find((book) => book.key === key);

        if (existing) {
            select.value = existing.shelf;
        }

        select.addEventListener("change", () => {
            const shelf = select.value;

            let updated: ShelfBook[] = JSON.parse(
                localStorage.getItem("shelfBooks") || "[]",
            );

            if (shelf === "" || shelf === "remove") {
                updated = updated.filter((book) => book.key !== key);
                select.value = "";
            } else {
                const existingIndex = updated.findIndex(
                    (book) => book.key === key,
                );

                const newBook: ShelfBook = {
                    key,
                    title: select.dataset.title || "",
                    cover_i: select.dataset.cover
                        ? Number(select.dataset.cover)
                        : undefined,
                    author_name: [select.dataset.author || "Unknown author"],
                    shelf,
                    lastUpdated: Date.now(),
                };

                if (existingIndex !== -1) {
                    updated[existingIndex] = newBook;
                } else {
                    updated.push(newBook);
                }
            }

            localStorage.setItem("shelfBooks", JSON.stringify(updated));
        });
    }

    const shareButton = document.querySelector(".share-button");

    shareButton?.addEventListener("click", async () => {
        const shareData = {
            title: document.title,
            text: "Check out this book",
            url: window.location.href,
        };

        if (navigator.share) {
            await navigator.share(shareData);
        } else {
            await navigator.clipboard.writeText(window.location.href);
            alert("Link copied!");
        }
    });
</script>

<style>
    .terug-link {
        background: none;
        border: none;
        padding: 0;
        margin-bottom: 1rem;
        color: inherit;
        text-decoration: none;
        font: inherit;
        cursor: pointer;
    }

    .book-detail {
        display: grid;
        grid-template-columns: 1fr;
        /* gap: 4rem; */
        gap: 1.5rem;
        align-items: start;
        max-width: 1200px;
        margin: 2rem auto 0;
    }

    .book-cover {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 2rem 0 1.5rem;
        perspective: 1200px;
        background: transparent;
        position: relative;
        overflow: visible;
    }
    .book-cover::before {
        content: "";
        position: absolute;
        inset: 3rem;
        border-radius: 50%;
        opacity: 0.45;
        filter: blur(2rem);
        z-index: -2;
    }

    /* book effect */

    .particles {
        position: absolute;
        inset: -4rem;
        z-index: -2;
    }
    .particles span {
        position: absolute;
        font-size: var(--size);
        top: 50%;
        left: 50%;
        opacity: 0;
        animation: effect 7s ease-in-out infinite;
        animation-delay: var(--delay);
    }
    .particles span:nth-child(1) {
        --x: -12rem;
        --y: -8rem;
        --size: 1.3rem;
        --delay: -1.5s;
    }
    .particles span:nth-child(2) {
        --x: 9rem;
        --y: -7rem;
        --size: 1.5rem;
        --delay: -1.7s;
    }
    .particles span:nth-child(3) {
        --x: -11rem;
        --y: 7rem;
        --size: 1rem;
        --delay: -2s;
    }
    .particles span:nth-child(4) {
        --x: 9rem;
        --y: 7rem;
        --size: 1.8rem;
        --delay: -2s;
    }
    .particles span:nth-child(5) {
        --x: 0rem;
        --y: -12rem;
        --size: 1.5rem;
        --delay: -3.2s;
    }
    /* romance books */
    .genre-romance .particles span::before {
        content: "♡";
        color: #ff8ab3;
    }
    /* fantasy books */
    .genre-fantasy .particles span::before {
        content: "✦ ✧ ✦";
        color: #9b7cff;
    }
    /* scifi books */
    .genre-scifi .particles span::before {
        content: "👽 ";
        color: #55111a;
    }
    /* action books */
    .genre-action .particles span::before {
        content: "☾ 𖤐";
    }
    /* horror books */
    .genre-horror .particles span::before {
        content: "🔥 ";
    }
    .genre-horror .book-3d {
        animation: horror 0.3s infinite alternate;
    }
    @keyframes horror {
        from {
            transform: rotateY(-22deg) translateX(-1px);
        }
        to {
            transform: rotateY(-22deg) translateX(1px);
        }
    }
    @keyframes effect {
        0% {
            transform: translate(-50%, -50%) scale(0.4);
            opacity: 0;
        }
        25% {
            opacity: 1;
        }
        75% {
            opacity: 1;
        }
        100% {
            transform: translate(
                    calc(-50% + var(--x) * 1.5),
                    calc(-50% + var(--y) * 1.5)
                )
                scale(3);
            opacity: 0;
        }
    }

    .book-3d {
        position: relative;
        width: min(14rem, 100%);
        transform-style: preserve-3d;
        transform: rotateY(-22deg);
        transition: transform 0.35s ease;
        z-index: 2;
    }

    /* pages thickness on the right */
    .book-3d::before {
        content: "";
        position: absolute;
        top: 0.45rem;
        right: -2.8rem;
        width: 2.8rem;
        height: calc(100% - 0.9rem);

        background: repeating-linear-gradient(
            to right,
            #f7ecd1 0,
            #f7ecd1 3px,
            #d6c19a 4px,
            #f7ecd1 6px
        );

        transform: translateZ(0.4rem) rotateY(72deg);
        transform-origin: left center;

        border-radius: 0 0.25rem 0.25rem 0;
        box-shadow: inset -0.35rem 0 0.45rem rgba(0, 0, 0, 0.16);
    }

    /* back cover */
    .book-3d::after {
        content: "";
        position: absolute;
        top: 0.35rem;
        right: -1.5rem;
        width: 1.2rem;
        height: calc(100% - 0.7rem);

        background: #6f4d35;
        border-radius: 0 0.25rem 0.25rem 0;

        transform: translateZ(-2rem);
        box-shadow: 0.8rem 1rem 1.6rem rgba(0, 0, 0, 0.22);
    }

    .book-3d img {
        width: 100%;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        display: block;
        border-radius: 0.35rem;
        box-shadow:
            1rem 1rem 1.7rem rgba(0, 0, 0, 0.28),
            inset -0.4rem 0 0 rgba(255, 255, 255, 0.1);
        position: relative;
        z-index: 2;
    }

    .book-cover::after {
        content: "";
        position: absolute;
        width: 13rem;
        height: 1.6rem;
        background: rgba(0, 0, 0, 0.22);
        filter: blur(0.75rem);
        border-radius: 50%;
        transform: translateY(10rem) rotate(-4deg);
        z-index: -1;
    }

    .book-3d:hover {
        transform: rotateY(-12deg) translateY(-0.4rem);
    }

    .cover-placeholder {
        width: 100%;
        max-width: 12rem;
        aspect-ratio: 2 / 3;
        display: grid;
        place-items: center;
        margin: 0 auto;
        border-radius: 0.8rem;
        background: #f3eee6;
        color: #666;
        text-align: center;
    }

    .book-info {
        display: grid;
        gap: 1rem;
    }

    .author {
        margin: 0;
        color: #6b655e;
        font-weight: 700;
    }

    h1 {
        margin: 0;
        font-size: clamp(2rem, 12vw, 3.2rem);
        line-height: 0.95;
        overflow-wrap: break-word;
    }
    .book-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .book-meta span {
        padding: 0.45rem 0.75rem;
        border-radius: 999px;
        color: #6b655e;
        background: rgba(255, 255, 255, 0.75);
        font-size: 0.85rem;
        line-height: 1;
    }

    .actions {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.75rem;
    }
    .shelf-select {
        border: 1px solid #d8d2c8;
        background: white;
    }

    .shelf-select,
    .share-button {
        width: 100%;
        padding: 0.85rem 1rem;
        border-radius: 999px;
        /* font: inherit; */
        font-weight: 700;
    }

    .share-button {
        border: none;
        background: #ff6b2c;
        color: white;
        font-weight: 700;
        cursor: pointer;
    }

    .description {
        margin-top: 0.5rem;
        padding: 1rem;
        border-radius: 1rem;
        /* background: white; */
        background: rgb(254 233 184);
        line-height: 1.7;
    }

    .description h2 {
        margin-top: 0;
    }
    .description p {
        max-height: 24rem;
        overflow-y: auto;
        padding-right: 0.5rem;
    }
    .related-books {
        margin-top: 2rem;
    }
    .related-grid {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
        
    }
    .related-card {
        flex: 0 0 8rem;
        text-decoration: none;
        color: inherit;
    }
    .related-card img,
    .related-placeholder {
        width: 100%;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        border-radius: 0.6rem;
        background: #f3eee6;
    }
    .related-placeholder {
        display: grid;
        place-items: center;
        font-size: 0.8rem;
        color: #666;
    }

    .related-card h3 {
        margin: 0.5rem 0 0;
        font-size: 0.9rem;
        line-height: 1.2;
    }

    @media (min-width: 48rem) {
        .book-detail {
            grid-template-columns: minmax(18rem, 26rem) minmax(0, 1fr);
            align-items: center;
            gap: 4rem;
        }
        .book-cover {
            position: sticky;
            top: 2rem;
            min-height: 34rem;
        }

        .book-3d {
            width: clamp(18rem, 24vw, 24rem);
        }

        .actions {
            grid-template-columns: 1fr auto;
            align-items: center;
        }

        .share-button {
            padding-inline: 1.2rem;
        }
    }
</style>
